.vercel
.env*
node_modules

# Archivo local de credenciales del EA (Email/Token/EaPassword) — solo en la
# máquina donde corre MT5, nunca en git. Ver CargarAuthDeArchivo() en
# EA_Aurum_Tracker_FIX.mq5. El archivo real vive en MT5\...\Common\Files\.
aurum_auth_*.txt

# Binarios compilados de MQL5 — se generan con F7 en MetaEditor desde el .mq5.
# Nunca en git: se recompilan en cada máquina y confunden con versiones viejas.
*.ex5

# Presets de inputs del EA exportados desde el terminal (.set). Contienen
# Email/EaPassword/Token en claro y se quedan obsoletos en cada rotación de
# EA_SHARED_SECRET — plantilla local, nunca en git.
*.set

# Análisis post-cierre (feature/post-cierre) — exports de Supabase y salida
# generada, nunca en git: son datos de trading reales, no código.
tools/post_cierre/data/
tools/post_cierre/salida/
tools/post_cierre/.venv/

# Caché de Python
__pycache__/

# Token del script post_cierre.py para api/post-cierre.js (POST_CIERRE_TOKEN
# en Vercel). Solo en la máquina donde corre MT5, nunca en git.
tools/post_cierre/.post_cierre_token
